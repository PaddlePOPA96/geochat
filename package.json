{
  "name": "chatguessr",
  "productName": "ChatGuessr",
  "version": "3.1.7",
  "description": "The GeoGuessr Twitch chatbot",
  "repository": "https://github.com/tzhf/chatguessr",
  "homepage": "https://chatguessr.com",
  "main": ".vite/build/main.js",
  "author": {
    "name": "ChatGuessr",
    "email": "chatguessr@gmail.com"
  },
  "license": "MIT",
  "scripts": {
    "dev": "npm run typecheck && electron-forge start",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "typecheck:node": "tsc -p tsconfig.node.json",
    "typecheck:web": "vue-tsc -p tsconfig.web.json",
    "lint": "eslint . --fix",
    "format": "prettier 'src/**/*.{ts,vue,json}' --write",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "start": "node server.cjs",
    "server": "node server.cjs",
    "build": "node scripts/bundle-server.mjs",
    "bundle": "node scripts/bundle-server.mjs",
    "build:exe": "node scripts/build-standalone.mjs",
    "test": "vitest run"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.10.2",
    "@electron-forge/maker-deb": "^7.10.2",
    "@electron-forge/maker-squirrel": "^7.10.2",
    "@electron-forge/maker-zip": "^7.10.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.10.2",
    "@electron-forge/plugin-vite": "^7.10.2",
    "@electron-forge/publisher-github": "^7.10.2",
    "@eslint/js": "^10.0.1",
    "@shaderfrog/glsl-parser": "^0.2.4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/google.maps": "^3.65.4",
    "@types/when-dom-ready": "^1.2.2",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vueuse/core": "^14.4.0",
    "axios": "^1.19.0",
    "electron": "^38.7.1",
    "electron-store": "^11.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "font-list": "^1.6.0",
    "format-duration": "^4.0.0",
    "fs-extra": "^11.4.0",
    "geojson-geometries-lookup": "^0.5.0",
    "match-sorter": "^8.3.0",
    "prettier": "^3.9.6",
    "socket.io-client": "^4.8.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^5.4.19",
    "vite-svg-loader": "^5.1.1",
    "vitest": "^3.1.2",
    "vue": "^3.5.40",
    "vue-tsc": "^3.3.9",
    "vue3-draggable-resizable": "^1.6.5",
    "when-dom-ready": "^1.2.12"
  },
  "dependencies": {
    "@osm_borders/maritime_10m": "^1.1.0",
    "better-sqlite3": "^12.4.4",
    "cors": "^2.8.6",
    "electron-squirrel-startup": "^1.0.1",
    "express": "^5.3.0",
    "socket.io": "^4.8.4",
    "tiktok-live-connector": "^2.5.0",
    "tsx": "^4.23.15",
    "update-electron-app": "^3.3.0",
    "youtube-chat": "^2.2.0",
    "youtubei.js": "^18.2.0"
  }
}
