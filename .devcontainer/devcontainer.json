{
  "name": "MabarBang Server Codespace",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-20-bookworm",
  "forwardPorts": [5050],
  "portsAttributes": {
    "5050": {
      "label": "MabarBang Server & Dashboard",
      "onAutoForward": "openBrowser",
      "visibility": "public"
    }
  },
  "postCreateCommand": "npm install --omit=dev --ignore-scripts || true",
  "postStartCommand": "echo 'Codespace siap! Ketik: npm start'",
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  }
}
